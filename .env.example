# Choose one supported provider: openai, groq, gemini, or anthropic.
LLM_PROVIDER=openai
LLM_MODEL=

# Set only the key for the provider you selected. Never commit .env.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional PageIndex fallback. Leave both empty to use hybrid retrieval only.
PAGEINDEX_API_KEY=
PAGEINDEX_API_URL=
PAGEINDEX_TIMEOUT=30
